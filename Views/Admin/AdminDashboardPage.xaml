<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.AdminDashboardPage"
                x:DataType="vm:AdminDashboardViewModel"
                Title="Administration">

    <Grid>
        <RefreshView Command="{Binding RetryCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="14">

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource CardTight}">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenPharmaciesCommand}" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Stats.ValidatedPharmacies}" Style="{StaticResource KpiValue}" TextColor="{StaticResource Success}" />
                                <Label Text="Pharmacies validées" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardTight}">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenPharmaciesCommand}" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Stats.PendingPharmacies}" Style="{StaticResource KpiValue}" TextColor="{StaticResource Warning}" />
                                <Label Text="En attente" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardTight}">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenReportsCommand}" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Stats.OpenReports}" Style="{StaticResource KpiValue}" TextColor="{StaticResource Danger}" />
                                <Label Text="Signalements ouverts" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource CardTight}">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenMedicinesCommand}" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Stats.Medicines}" Style="{StaticResource KpiValue}" />
                                <Label Text="Médicaments" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardTight}">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenUsersCommand}" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Stats.Users}" Style="{StaticResource KpiValue}" />
                                <Label Text="Utilisateurs" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardTight}">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenStatsCommand}" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Stats.SearchesLast7Days}" Style="{StaticResource KpiValue}" TextColor="{StaticResource Secondary}" />
                                <Label Text="Recherches (7 j)" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Qualité des données -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Text="Qualité des données" Style="{StaticResource H3}" />
                            <Label Grid.Column="1" Text="{Binding Stats.StaleStockText}" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Caption}"
                                   Text="des lignes de stock des pharmacies validées n'ont pas été mises à jour depuis plus de 72 h." />
                        </Grid>
                    </Border>

                    <!-- Validations en attente -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Demandes à valider" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Text="Tout voir" Style="{StaticResource TextButton}" Command="{Binding OpenPharmaciesCommand}" />
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pending}">
                            <BindableLayout.EmptyView>
                                <Label Text="Aucune demande en attente." Style="{StaticResource BodySecondary}" Padding="16" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:Pharmacy">
                                    <VerticalStackLayout>
                                        <Grid Padding="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminDashboardViewModel}}, Path=ReviewCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                                <Label Text="{Binding FullLocationText}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="Examiner" TextColor="{StaticResource Primary}" FontAttributes="Bold" VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView Style="{StaticResource Divider}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Signalements récents -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Signalements à traiter" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Text="Tout voir" Style="{StaticResource TextButton}" Command="{Binding OpenReportsCommand}" />
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentReports}">
                            <BindableLayout.EmptyView>
                                <Label Text="Aucun signalement ouvert." Style="{StaticResource BodySecondary}" Padding="16" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:PharmacyReport">
                                    <VerticalStackLayout>
                                        <Grid Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="3">
                                            <Label Text="{Binding ReasonText}" FontAttributes="Bold" />
                                            <c:Badge Grid.Column="1" Value="{Binding Status}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subject}" Style="{StaticResource Caption}" />
                                        </Grid>
                                        <BoxView Style="{StaticResource Divider}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <c:StateView State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}" />
    </Grid>
</views:BasePage>
