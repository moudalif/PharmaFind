<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                x:Class="PharmaFind.Views.AdminMorePage"
                x:DataType="vm:AdminMoreViewModel"
                Title="Plus">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Style="{StaticResource IconCircle}" BackgroundColor="{StaticResource SecondaryLight}">
                        <Image Source="tab_shield.png" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding AdminName}" Style="{StaticResource H3}" />
                        <Label Text="{Binding AdminEmail}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenUsersCommand}" /></Grid.GestureRecognizers>
                        <Image Source="ic_users.png" Style="{StaticResource ListIcon}" />
                        <Label Grid.Column="1" Text="Comptes utilisateurs" VerticalOptions="Center" />
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="16" HeightRequest="16" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenStatsCommand}" /></Grid.GestureRecognizers>
                        <Image Source="ic_chart.png" Style="{StaticResource ListIcon}" />
                        <Label Grid.Column="1" Text="Statistiques et qualité des données" VerticalOptions="Center" />
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="16" HeightRequest="16" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenAuditCommand}" /></Grid.GestureRecognizers>
                        <Image Source="ic_audit.png" Style="{StaticResource ListIcon}" />
                        <Label Grid.Column="1" Text="Journal d'audit" VerticalOptions="Center" />
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="16" HeightRequest="16" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSettingsCommand}" /></Grid.GestureRecognizers>
                        <Image Source="ic_settings.png" Style="{StaticResource ListIcon}" />
                        <Label Grid.Column="1" Text="Paramètres de l'application" VerticalOptions="Center" />
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="16" HeightRequest="16" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource Caption}" Text="Une interface web d'administration pourra compléter cette application pour plus de confort sur grand écran." />
            <Button Text="Se déconnecter" Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
