<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.AdminReportsPage"
                x:DataType="vm:AdminReportsViewModel"
                Title="Signalements">

    <Grid RowDefinitions="Auto,*">
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" Padding="16,14,16,8" BindableLayout.ItemsSource="{Binding StatusChips}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:FilterChip">
                        <Border Style="{StaticResource Chip}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminReportsViewModel}}, Path=SelectStatusCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Label}" FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:PharmacyReport">
                        <Grid Padding="16,5">
                            <Border Style="{StaticResource CardTight}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminReportsViewModel}}, Path=ManageCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding ReasonText}" Style="{StaticResource H3}" />
                                        <c:Badge Grid.Column="1" Value="{Binding Status}" />
                                    </Grid>
                                    <Label Text="{Binding Subject}" FontSize="14" TextColor="{StaticResource Secondary}" />
                                    <Label Text="{Binding Comment}" Style="{StaticResource BodySecondary}" FontSize="13" MaxLines="3" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Author}" />
                                                <Span Text=" · " />
                                                <Span Text="{Binding CreatedText}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <c:StateView State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}"
                         EmptyTitle="Aucun signalement" EmptyMessage="Aucun signalement dans cette catégorie." />
        </Grid>
    </Grid>
</views:BasePage>
