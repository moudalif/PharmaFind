<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.AdminPharmaciesPage"
                x:DataType="vm:AdminPharmaciesViewModel"
                Title="Pharmacies">

    <Grid RowDefinitions="Auto,Auto,*">
        <Border Style="{StaticResource InputBorder}" Margin="16,16,16,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Image Source="ic_search.png" Style="{StaticResource ListIcon}" />
                <Entry Grid.Column="1" Text="{Binding FilterText}" Placeholder="Nom, quartier, ville ou n° d'autorisation" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" Padding="16,0,16,8" BindableLayout.ItemsSource="{Binding StatusChips}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:FilterChip">
                        <Border Style="{StaticResource Chip}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminPharmaciesViewModel}}, Path=SelectStatusCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Label}" FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Pharmacy">
                        <Grid Padding="16,5">
                            <Border Style="{StaticResource CardTight}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminPharmaciesViewModel}}, Path=OpenCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource H3}" />
                                        <Label Text="{Binding FullLocationText}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <c:Badge Grid.Column="1" Value="{Binding Status}" VerticalOptions="Start" />
                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="12">
                                        <Label Text="{Binding LicenseNumber}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding PhoneDisplay}" Style="{StaticResource Caption}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <c:StateView State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}"
                         EmptyTitle="Aucune pharmacie" EmptyMessage="Aucune pharmacie ne correspond à ce filtre." />
        </Grid>
    </Grid>
</views:BasePage>
