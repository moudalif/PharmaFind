<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.ReportPage"
                x:DataType="vm:ReportViewModel"
                Title="Signaler une erreur">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Pharmacie concernée" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding PharmacyName}" Style="{StaticResource H3}" />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0" IsVisible="{Binding MedicineName, Converter={StaticResource HasValue}}">
                            <CheckBox IsChecked="{Binding IncludeMedicine}" />
                            <Label Grid.Column="1" VerticalOptions="Center" FontSize="14">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Concerne le médicament " />
                                        <Span Text="{Binding MedicineName}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Motif" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reasons}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:ReasonOption">
                                <VerticalStackLayout>
                                    <Grid Padding="16,13" ColumnDefinitions="*,Auto">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReportViewModel}}, Path=SelectReasonCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="{Binding Text}" VerticalOptions="Center" />
                                        <Ellipse Grid.Column="1" WidthRequest="20" HeightRequest="20" Stroke="{StaticResource Border}" StrokeThickness="2" Fill="White">
                                            <Ellipse.Triggers>
                                                <DataTrigger TargetType="Ellipse" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Primary}" />
                                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                    </Grid>
                                    <BoxView Style="{StaticResource Divider}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Précisions (facultatif)" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource InputBorder}" Padding="12,6">
                    <Editor Text="{Binding Comment}" MaxLength="500" HeightRequest="120"
                            Placeholder="Ex. : indiqué disponible mais en rupture au comptoir ce matin." />
                </Border>
                <Label Text="{Binding CounterText}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />

                <Border Style="{StaticResource DangerBanner}" IsVisible="{Binding ErrorText, Converter={StaticResource HasValue}}">
                    <Label Text="{Binding ErrorText}" Style="{StaticResource ErrorLabel}" />
                </Border>

                <Button Text="Envoyer le signalement" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsWorking, Converter={StaticResource InvertedBool}}" />
                <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                       Text="N'indiquez aucune information de santé personnelle. Le signalement peut être anonyme." />
            </VerticalStackLayout>
        </ScrollView>
        <c:StateView State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}" />
    </Grid>
</views:BasePage>
