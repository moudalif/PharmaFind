<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.HomePage"
                x:DataType="vm:HomeViewModel"
                Title="Accueil"
                Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- En-tête -->
            <Grid BackgroundColor="{StaticResource Primary}" Padding="20,48,20,28" RowSpacing="14" RowDefinitions="Auto,Auto,Auto,Auto">
                <HorizontalStackLayout Spacing="10">
                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="4">
                        <Image Source="logo.png" WidthRequest="26" HeightRequest="26" />
                    </Border>
                    <Label Text="PharmaFind" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="2">
                    <Label Text="{Binding Greeting}" TextColor="#D1FAE5" FontSize="15" />
                    <Label Text="Trouvez votre médicament dans une pharmacie proche" TextColor="White" FontSize="22" FontAttributes="Bold" />
                </VerticalStackLayout>

                <!-- Fausse barre de recherche : ouvre l'écran de recherche -->
                <Border Grid.Row="2" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,0" HeightRequest="52"
                        SemanticProperties.Description="Rechercher un médicament">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSearchCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Image Source="ic_search.png" Style="{StaticResource ListIcon}" />
                        <Label Text="Nom du médicament ou DCI…" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Position -->
                <Border Grid.Row="3" BackgroundColor="#1A9A6E" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="12,8" HorizontalOptions="Start">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChooseLocationCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="ic_location_white.png" WidthRequest="16" HeightRequest="16" />
                        <Label Text="{Binding Search.LocationLabel}" TextColor="White" FontSize="14" VerticalOptions="Center" />
                        <Label Text="Modifier" TextColor="#D1FAE5" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <VerticalStackLayout Padding="16,20,16,24" Spacing="20">

                <!-- Accès rapides -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource CardTight}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenMapCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource IconCircle}">
                                <Image Source="tab_map.png" />
                            </Border>
                            <Label Text="Carte des pharmacies" Style="{StaticResource H3}" FontSize="15" />
                            <Label Text="Autour de vous" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardTight}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenHistoryCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource IconCircle}" BackgroundColor="{StaticResource SecondaryLight}">
                                <Image Source="ic_history.png" />
                            </Border>
                            <Label Text="Mes recherches" Style="{StaticResource H3}" FontSize="15" />
                            <Label Text="Historique" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Recherches récentes -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding RecentSearches.Count, Converter={StaticResource HasValue}}">
                    <Label Text="Recherches récentes" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentSearches}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:SearchHistoryEntry">
                                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SelectRecentCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Image Source="ic_history.png" Style="{StaticResource ListIcon}" />
                                        <Label Grid.Column="1" Text="{Binding Query}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Médicaments les plus recherchés -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Les plus recherchés à Douala" Style="{StaticResource SectionTitle}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
                    <Border Style="{StaticResource WarningBanner}" IsVisible="{Binding HasError}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Impossible de charger les suggestions." FontSize="14" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Réessayer" Style="{StaticResource TextButton}" Command="{Binding RetryCommand}" />
                        </Grid>
                    </Border>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-16,0">
                        <HorizontalStackLayout Spacing="12" Padding="16,0" BindableLayout.ItemsSource="{Binding PopularMedicines}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:Medicine">
                                    <Border Style="{StaticResource CardTight}" WidthRequest="168">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SelectMedicineCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="6">
                                            <Border Style="{StaticResource IconCircle}" WidthRequest="36" HeightRequest="36" Padding="8">
                                                <Image Source="ic_pill.png" />
                                            </Border>
                                            <Label Text="{Binding DisplayName}" Style="{StaticResource H3}" FontSize="15" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Details}" Style="{StaticResource Caption}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Rappel de fiabilité -->
                <Border Style="{StaticResource InfoBanner}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_info_blue.png" Style="{StaticResource ListIcon}" VerticalOptions="Start" />
                        <Label Grid.Column="1" FontSize="13" TextColor="{StaticResource TextSecondary}"
                               Text="La disponibilité affichée est déclarée par les pharmacies et n'est pas une garantie. Appelez avant de vous déplacer. PharmaFind ne donne aucun conseil médical." />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
