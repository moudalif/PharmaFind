<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.LocationPickerPage"
                x:DataType="vm:LocationPickerViewModel"
                Title="Où chercher ?">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <VerticalStackLayout Padding="16,16,16,8" Spacing="10">
            <Label Style="{StaticResource Caption}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Position actuelle : " />
                        <Span Text="{Binding CurrentLabel}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Button Text="Utiliser ma position actuelle" ImageSource="ic_location_white.png" Command="{Binding UseGpsCommand}"
                    IsEnabled="{Binding IsWorking, Converter={StaticResource InvertedBool}}" />
            <ActivityIndicator IsRunning="{Binding IsWorking}" IsVisible="{Binding IsWorking}" />
            <Label Style="{StaticResource Caption}" Text="Votre position sert uniquement à cette recherche et n'est pas conservée." />
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource WarningBanner}" Margin="16,0,16,8" IsVisible="{Binding GpsError, Converter={StaticResource HasValue}}">
            <Label Text="{Binding GpsError}" FontSize="13" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource InputBorder}" Margin="16,4,16,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Image Source="ic_search.png" Style="{StaticResource ListIcon}" />
                <Entry Grid.Column="1" Text="{Binding Query}" Placeholder="Ville, arrondissement ou quartier (ex. : Akwa)" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <CollectionView ItemsSource="{Binding Places}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:KnownPlace">
                        <VerticalStackLayout Padding="16,0">
                            <Grid Padding="4,13" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationPickerViewModel}}, Path=SelectPlaceCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Image Source="ic_location.png" Style="{StaticResource ListIcon}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView Style="{StaticResource Divider}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <c:StateView State="{Binding State}" EmptyTitle="Lieu non reconnu"
                         EmptyMessage="Essayez le nom du quartier ou de la ville. D'autres lieux seront ajoutés avec le géocodage de l'API." />
        </Grid>
    </Grid>
</views:BasePage>
