<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.ResultsPage"
                x:DataType="vm:ResultsViewModel"
                Title="Résultats">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Carte" Command="{Binding ShowMapCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Médicament et position -->
        <VerticalStackLayout Padding="16,14,16,6" Spacing="10" BackgroundColor="{StaticResource Surface}">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Medicine.DisplayName}" Style="{StaticResource H2}" />
                    <Label Text="{Binding Medicine.Details}" Style="{StaticResource BodySecondary}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Fiche" Style="{StaticResource TextButton}" Command="{Binding OpenMedicineCommand}" VerticalOptions="Start" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Image Source="ic_location_green.png" WidthRequest="18" HeightRequest="18" />
                <Label Grid.Column="1" Text="{Binding Search.LocationLabel}" FontSize="14" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <Button Grid.Column="2" Text="Modifier" Style="{StaticResource TextButton}" Command="{Binding ChangeLocationCommand}" />
            </Grid>
        </VerticalStackLayout>

        <!-- Rayon -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" BackgroundColor="{StaticResource Surface}"
                    IsVisible="{Binding NeedsLocation, Converter={StaticResource InvertedBool}}">
            <HorizontalStackLayout Spacing="8" Padding="16,4,16,10">
                <Label Text="Rayon" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding RadiusChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:FilterChip">
                            <Border Style="{StaticResource Chip}" Padding="12,6">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ResultsViewModel}}, Path=SelectRadiusCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" FontSize="13">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Filtres -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    IsVisible="{Binding NeedsLocation, Converter={StaticResource InvertedBool}}">
            <HorizontalStackLayout Spacing="8" Padding="16,10,16,4">
                <Border Style="{StaticResource Chip}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding OnlyAvailable}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleOnlyAvailableCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Disponible uniquement" FontSize="13" />
                </Border>
                <Border Style="{StaticResource Chip}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding OnlyOpen}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleOnlyOpenCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Ouverte maintenant" FontSize="13" />
                </Border>
                <Border Style="{StaticResource Chip}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleSortCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding SortText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3">
            <CollectionView ItemsSource="{Binding Results}" SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="16,6,16,4" Spacing="8">
                        <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource WarningBanner}" IsVisible="{Binding HasStaleResults}">
                            <Label FontSize="13" Text="Certains stocks n'ont pas été mis à jour récemment : appelez la pharmacie avant de vous déplacer." />
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:PharmacyResult">
                        <Grid Padding="16,5">
                            <Border Style="{StaticResource CardTight}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ResultsViewModel}}, Path=OpenPharmacyCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="10" InputTransparent="True">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Pharmacy.Name}" Style="{StaticResource H3}" />
                                        <Label Text="{Binding Pharmacy.LocationText}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                                        <Label Text="{Binding PriceText}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="End" />
                                        <Label Text="prix indicatif" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="10">
                                        <c:Badge Value="{Binding Status}" />
                                        <Label Text="{Binding DistanceText}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Label Text="{Binding Pharmacy.OpenText}" FontSize="13" VerticalOptions="Center"
                                               TextColor="{Binding IsOpen, Converter={StaticResource OpenColor}}" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="6">
                                        <Image Source="ic_clock.png" WidthRequest="14" HeightRequest="14" />
                                        <Label Text="{Binding UpdatedText}" FontSize="12"
                                               TextColor="{Binding Freshness, Converter={StaticResource FreshnessColor}}" />
                                        <Label Text="· à confirmer par téléphone" FontSize="12" TextColor="{StaticResource Danger}" IsVisible="{Binding IsStale}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>

            <c:StateView State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}"
                         EmptyTitle="Aucune pharmacie trouvée"
                         EmptyMessage="Aucune pharmacie de ce rayon ne déclare ce médicament avec ces filtres."
                         EmptyActionText="{Binding ExpandText}" EmptyActionCommand="{Binding ExpandRadiusCommand}" />

            <!-- Position requise -->
            <VerticalStackLayout IsVisible="{Binding NeedsLocation}" BackgroundColor="{StaticResource Background}"
                                 Padding="32" Spacing="12" VerticalOptions="Fill">
                <Image Source="state_location.png" WidthRequest="64" HeightRequest="64" Margin="0,24,0,0" />
                <Label Text="Où cherchez-vous ?" Style="{StaticResource H2}" HorizontalTextAlignment="Center" />
                <Label Style="{StaticResource BodySecondary}" HorizontalTextAlignment="Center"
                       Text="Pour trouver les pharmacies proches, autorisez la localisation ou indiquez un quartier. Votre position n'est pas conservée." />
                <Button Text="Utiliser ma position" Command="{Binding UseMyLocationCommand}" IsEnabled="{Binding IsWorking, Converter={StaticResource InvertedBool}}" />
                <Button Text="Saisir un quartier ou une ville" Style="{StaticResource OutlineButton}" Command="{Binding ChangeLocationCommand}" />
                <ActivityIndicator IsRunning="{Binding IsWorking}" IsVisible="{Binding IsWorking}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</views:BasePage>
