<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.FavoritesPage"
                x:DataType="vm:FavoritesViewModel"
                Title="Mes pharmacies favorites">

    <Grid>
        <CollectionView ItemsSource="{Binding Favorites}" SelectionMode="None" Margin="0,8,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:Pharmacy">
                    <Grid Padding="16,5">
                        <Border Style="{StaticResource CardTight}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=OpenCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource IconCircle}">
                                    <Image Source="ic_store.png" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource H3}" />
                                    <Label Text="{Binding LocationText}" Style="{StaticResource Caption}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <c:Badge Value="{Binding IsOpenNow}" />
                                        <Label Text="{Binding HoursText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <ImageButton Grid.Column="2" Source="ic_phone_green.png" BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40" Padding="9"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=CallCommand}"
                                             CommandParameter="{Binding .}" SemanticProperties.Description="Appeler" />
                                <ImageButton Grid.Column="3" Source="ic_heart_filled.png" BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40" Padding="9"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=RemoveCommand}"
                                             CommandParameter="{Binding .}" SemanticProperties.Description="Retirer des favoris" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <c:StateView State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}"
                     EmptyTitle="Aucun favori"
                     EmptyMessage="Touchez le cœur sur la fiche d'une pharmacie pour la retrouver ici." />

        <!-- Compte facultatif -->
        <VerticalStackLayout IsVisible="{Binding RequiresLogin}" BackgroundColor="{StaticResource Background}" Padding="32" Spacing="12">
            <Image Source="state_lock.png" WidthRequest="64" HeightRequest="64" Margin="0,40,0,0" />
            <Label Text="Gardez vos pharmacies à portée de main" Style="{StaticResource H2}" HorizontalTextAlignment="Center" />
            <Label Style="{StaticResource BodySecondary}" HorizontalTextAlignment="Center"
                   Text="Les favoris nécessitent un compte gratuit. La recherche de médicaments reste accessible sans inscription." />
            <Button Text="Se connecter" Command="{Binding LoginCommand}" />
            <Button Text="Créer un compte" Style="{StaticResource OutlineButton}" Command="{Binding RegisterCommand}" />
        </VerticalStackLayout>
    </Grid>
</views:BasePage>
