<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.MedicineDetailPage"
                x:DataType="vm:MedicineDetailViewModel"
                Title="Médicament">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Border Style="{StaticResource IconCircle}" WidthRequest="52" HeightRequest="52" Padding="12">
                            <Image Source="ic_pill.png" />
                        </Border>
                        <Label Text="{Binding Medicine.DisplayName}" Style="{StaticResource H1}" />
                        <Label Text="{Binding Medicine.Category}" Style="{StaticResource BodySecondary}" />
                        <c:Badge Value="{Binding Medicine.Delivery}" TextOverride="{Binding Medicine.DeliveryText}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" Padding="16" RowSpacing="12" ColumnSpacing="16">
                        <Label Text="Nom commercial" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Column="1" Text="{Binding Medicine.BrandName}" HorizontalTextAlignment="End" />
                        <Label Grid.Row="1" Text="DCI" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Medicine.Inn}" HorizontalTextAlignment="End" />
                        <Label Grid.Row="2" Text="Dosage" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Medicine.Dosage}" HorizontalTextAlignment="End" />
                        <Label Grid.Row="3" Text="Forme" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Medicine.Form}" HorizontalTextAlignment="End" />
                        <Label Grid.Row="4" Text="Délivrance" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Medicine.DeliveryText}" HorizontalTextAlignment="End" />
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Description" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding Medicine.Description}" Style="{StaticResource BodySecondary}" FontSize="15" />
                </VerticalStackLayout>

                <Border Style="{StaticResource WarningBanner}" IsVisible="{Binding Medicine.RequiresPrescription}">
                    <Label FontSize="13" Text="Ce médicament est délivré sur présentation d'une ordonnance. PharmaFind ne permet ni la vente ni la réservation." />
                </Border>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding Equivalents.Count, Converter={StaticResource HasValue}}">
                    <Label Text="Même DCI, autres présentations" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Equivalents}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:Medicine">
                                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MedicineDetailViewModel}}, Path=OpenEquivalentCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                            <Label Text="{Binding Form}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <Image Grid.Column="1" Source="ic_chevron.png" WidthRequest="18" HeightRequest="18" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border Style="{StaticResource InfoBanner}">
                    <Label FontSize="13" TextColor="{StaticResource TextSecondary}"
                           Text="Informations générales, sans valeur de conseil médical. Pour la posologie, les contre-indications ou le choix d'un traitement, demandez l'avis d'un pharmacien ou d'un médecin." />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="16,10,16,16">
            <Button Text="Trouver une pharmacie" Command="{Binding FindPharmaciesCommand}" />
        </Border>

        <c:StateView Grid.RowSpan="2" State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}" />
    </Grid>
</views:BasePage>
