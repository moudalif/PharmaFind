<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.StockPage"
                x:DataType="vm:StockViewModel"
                Title="Mes stocks">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Ajouter" Command="{Binding AddFromCatalogCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border Style="{StaticResource InputBorder}" Margin="16,16,16,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Image Source="ic_search.png" Style="{StaticResource ListIcon}" />
                <Entry Grid.Column="1" Text="{Binding FilterText}" Placeholder="Rechercher dans mon inventaire" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" Padding="16,0,16,8" BindableLayout.ItemsSource="{Binding StatusChips}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:FilterChip">
                        <Border Style="{StaticResource Chip}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StockViewModel}}, Path=SelectStatusCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Label}" FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="20,0,12,4">
            <Label Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Tout confirmer" Style="{StaticResource TextButton}" FontSize="13" Command="{Binding ConfirmAllCommand}" />
        </Grid>

        <Grid Grid.Row="3">
            <RefreshView Command="{Binding RetryCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
                <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:StockItem">
                            <Grid Padding="16,5">
                                <Border Style="{StaticResource CardTight}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StockViewModel}}, Path=EditCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Medicine.DisplayName}" Style="{StaticResource H3}" />
                                            <Label Text="{Binding Medicine.Details}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                            <Label Text="{Binding PriceText}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding QuantityText}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
                                            <c:Badge Value="{Binding Status}" />
                                            <c:Badge Value="{Binding Freshness}" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding UpdatedText}" FontSize="12"
                                               TextColor="{Binding Freshness, Converter={StaticResource FreshnessColor}}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
            <c:StateView State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}"
                         EmptyTitle="Aucune ligne de stock"
                         EmptyMessage="Aucun médicament ne correspond à ce filtre. Ajoutez des médicaments depuis le catalogue central."
                         EmptyActionText="Ouvrir le catalogue" EmptyActionCommand="{Binding AddFromCatalogCommand}" />
        </Grid>
    </Grid>
</views:BasePage>
