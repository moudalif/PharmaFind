<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.NotificationsPage"
                x:DataType="vm:NotificationsViewModel"
                Title="Alertes">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Tout lu" Command="{Binding MarkAllReadCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <!-- Onglets -->
        <Grid ColumnDefinitions="*,*" Padding="16,12" ColumnSpacing="8">
            <Border Style="{StaticResource Chip}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding ShowAlerts}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowTabCommand}" CommandParameter="alerts" />
                </Border.GestureRecognizers>
                <Label Text="{Binding UnreadCount, StringFormat='Alertes ({0} non lues)'}" HorizontalTextAlignment="Center" FontSize="13">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding ShowAlerts}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Chip}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding ShowReports}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowTabCommand}" CommandParameter="reports" />
                </Border.GestureRecognizers>
                <Label Text="{Binding Reports.Count, StringFormat='Signalements ({0})'}" HorizontalTextAlignment="Center" FontSize="13">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding ShowReports}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Alertes -->
            <CollectionView ItemsSource="{Binding Notifications}" SelectionMode="None" IsVisible="{Binding ShowAlerts}">
                <CollectionView.EmptyView>
                    <Label Text="Aucune alerte." Style="{StaticResource BodySecondary}" HorizontalTextAlignment="Center" Margin="32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:AppNotification">
                        <Grid Padding="16,4">
                            <Border Style="{StaticResource CardTight}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsRead}" Value="False">
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Image Source="{Binding Icon}" Style="{StaticResource ListIcon}" VerticalOptions="Start" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Title}" FontAttributes="{Binding IsRead, Converter={StaticResource UnreadFont}}" />
                                            <Label Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource Caption}" />
                                        </Grid>
                                        <Label Text="{Binding Message}" Style="{StaticResource BodySecondary}" FontSize="13" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Signalements -->
            <CollectionView ItemsSource="{Binding Reports}" SelectionMode="None" IsVisible="{Binding ShowReports}">
                <CollectionView.EmptyView>
                    <Label Text="Aucun signalement concernant votre pharmacie." Style="{StaticResource BodySecondary}" HorizontalTextAlignment="Center" Margin="32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:PharmacyReport">
                        <Grid Padding="16,4">
                            <Border Style="{StaticResource CardTight}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenReportCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding ReasonText}" FontAttributes="Bold" />
                                        <c:Badge Grid.Column="1" Value="{Binding Status}" />
                                    </Grid>
                                    <Label Text="{Binding MedicineName}" FontSize="13" TextColor="{StaticResource Secondary}"
                                           IsVisible="{Binding MedicineName, Converter={StaticResource HasValue}}" />
                                    <Label Text="{Binding Comment}" Style="{StaticResource BodySecondary}" FontSize="13" MaxLines="3" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding CreatedText}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <c:StateView State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}" />
        </Grid>
    </Grid>
</views:BasePage>
