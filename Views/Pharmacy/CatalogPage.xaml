<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.CatalogPage"
                x:DataType="vm:CatalogViewModel"
                Title="Catalogue central">

    <Grid RowDefinitions="Auto,Auto,*">
        <VerticalStackLayout Padding="16,16,16,4" Spacing="10">
            <Border Style="{StaticResource InputBorder}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Image Source="ic_search.png" Style="{StaticResource ListIcon}" />
                    <Entry Grid.Column="1" Text="{Binding FilterText}" Placeholder="Nom, DCI ou catégorie" />
                </Grid>
            </Border>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Masquer ceux déjà dans mon stock" VerticalOptions="Center" FontSize="14" />
                <Switch Grid.Column="1" IsToggled="{Binding HideInInventory}" />
            </Grid>
        </VerticalStackLayout>

        <Label Grid.Row="1" Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="20,0,16,6" />

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogEntry">
                        <Grid Padding="16,5">
                            <Border Style="{StaticResource CardTight}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, Path=SelectCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Medicine.DisplayName}" Style="{StaticResource H3}" />
                                        <Label Text="{Binding Medicine.Details}" Style="{StaticResource Caption}" />
                                        <HorizontalStackLayout Spacing="8" Margin="0,3,0,0">
                                            <c:Badge Value="{Binding Medicine.Delivery}" />
                                            <Label Text="Dans mon stock" FontSize="12" TextColor="{StaticResource Success}" FontAttributes="Bold"
                                                   VerticalOptions="Center" IsVisible="{Binding InInventory}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalOptions="Center" BackgroundColor="{StaticResource PrimaryLight}" Stroke="{StaticResource PrimaryLight}">
                                        <Label Text="{Binding ActionText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Button Text="Un médicament manque au catalogue ?" Style="{StaticResource TextButton}" Command="{Binding RequestMissingCommand}" Margin="16,8,16,24" />
                </CollectionView.Footer>
            </CollectionView>
            <c:StateView State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}"
                         EmptyTitle="Aucun médicament" EmptyMessage="Aucun médicament du catalogue ne correspond à votre recherche."
                         EmptyActionText="Signaler un médicament manquant" EmptyActionCommand="{Binding RequestMissingCommand}" />
        </Grid>
    </Grid>
</views:BasePage>
