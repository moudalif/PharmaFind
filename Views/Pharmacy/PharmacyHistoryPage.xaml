<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:PharmaFind.Views"
                xmlns:vm="clr-namespace:PharmaFind.ViewModels"
                xmlns:m="clr-namespace:PharmaFind.Models"
                xmlns:c="clr-namespace:PharmaFind.Controls"
                x:Class="PharmaFind.Views.PharmacyHistoryPage"
                x:DataType="vm:PharmacyHistoryViewModel"
                Title="Historique des modifications">

    <Grid>
        <CollectionView ItemsSource="{Binding Changes}" SelectionMode="None" Margin="0,8,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:StockChange">
                    <Grid Padding="16,0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <!-- Frise chronologique -->
                        <Grid WidthRequest="12">
                            <BoxView WidthRequest="2" Color="{StaticResource Border}" HorizontalOptions="Center" />
                            <Ellipse WidthRequest="12" HeightRequest="12" Fill="{StaticResource Primary}" VerticalOptions="Start" Margin="0,16,0,0" />
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" Padding="0,12" Spacing="3">
                            <Label Text="{Binding MedicineName}" FontAttributes="Bold" />
                            <Label Text="{Binding Description}" Style="{StaticResource BodySecondary}" FontSize="14" />
                            <Label Style="{StaticResource Caption}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding DateText}" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding Author}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <c:StateView State="{Binding State}" Message="{Binding StateMessage}" RetryCommand="{Binding RetryCommand}"
                     EmptyTitle="Aucune modification" EmptyMessage="Les mises à jour de stock et de fiche apparaîtront ici." />
    </Grid>
</views:BasePage>
