<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Charte PharmaFind : vert médical, bleu doux, fonds clairs. Contrastes vérifiés ≥ 4,5:1 pour le texte. -->
    <Color x:Key="Primary">#12805C</Color>
    <Color x:Key="PrimaryDark">#0B5F44</Color>
    <Color x:Key="PrimaryLight">#E6F4EE</Color>
    <Color x:Key="Secondary">#2F74B5</Color>
    <Color x:Key="SecondaryLight">#E8F1FA</Color>

    <Color x:Key="Background">#F5F7F9</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Border">#E3E7EB</Color>
    <Color x:Key="Divider">#EEF1F4</Color>

    <Color x:Key="TextPrimary">#111827</Color>
    <Color x:Key="TextSecondary">#4B5563</Color>
    <Color x:Key="TextMuted">#6B7280</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>

    <!-- Statuts de disponibilité -->
    <Color x:Key="Success">#15803D</Color>
    <Color x:Key="SuccessLight">#DCFCE7</Color>
    <Color x:Key="Warning">#B45309</Color>
    <Color x:Key="WarningLight">#FEF3C7</Color>
    <Color x:Key="Danger">#B91C1C</Color>
    <Color x:Key="DangerLight">#FEE2E2</Color>
    <Color x:Key="Neutral">#4B5563</Color>
    <Color x:Key="NeutralLight">#F1F3F5</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
</ResourceDictionary>
