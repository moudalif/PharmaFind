<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:PharmaFind.Converters"
             x:Class="PharmaFind.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertedBoolConverter x:Key="InvertedBool" />
            <conv:HasValueConverter x:Key="HasValue" />
            <conv:FreshnessToColorConverter x:Key="FreshnessColor" />
            <conv:AvailabilityToColorConverter x:Key="AvailabilityColor" />
            <conv:OpenToColorConverter x:Key="OpenColor" />
            <conv:UnreadToFontConverter x:Key="UnreadFont" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
